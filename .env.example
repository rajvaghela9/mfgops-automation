# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# --- Modes ---
# "file" reads orders from a Fusion backlog report Excel file (BACKLOG_FILE_PATH below);
# "mock" (default) uses invented sample orders; "live" calls Fusion Dev1 (not wired yet).
FUSION_MODE=mock
# Used when FUSION_MODE=file: the "Infoblox Orders Backlog Report" .xls from Fusion.
BACKLOG_FILE_PATH=
# In file mode, also load 10 invented orders that the AI should reject or hold (demo).
INCLUDE_DEMO_ORDERS=true
# "mock" writes OM emails to OUTBOX_DIR; "live" sends through MS Graph (pending access).
EMAIL_MODE=mock

# --- Fusion Dev1 (only needed when FUSION_MODE=live) ---
FUSION_BASE_URL=https://efpv-dev1.fa.us6.oraclecloud.com
# Either Basic Auth for the integration user...
FUSION_USERNAME=
FUSION_PASSWORD=
# ...or OAuth 2.0 client credentials (used when all three are set).
FUSION_CLIENT_ID=
FUSION_CLIENT_SECRET=
FUSION_TOKEN_URL=

# --- AI via Infoblox LiteLLM proxy. Blank = AI off: only the fixed (hard) rules run ---
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Tested: gpt-5.4-mini (fast, cheap, good). Run `/v1/models` on your proxy for others.
LITELLM_MODEL=gpt-5.4-mini

# --- Email ---
OM_TEAM_EMAIL=

# --- Storage (all under data/, which is gitignored) ---
DB_PATH=data/mfgops.db
# Where paused order reviews and rule chats are saved (LangGraph checkpoints).
WORKFLOW_DB_PATH=data/workflow_checkpoints.db
ATTACHMENTS_DIR=data/attachments
OUTBOX_DIR=data/outbox

# --- Service ---
POLL_INTERVAL_SECONDS=300
HEALTHZ_PORT=8080
# Assumed manual minutes saved per order (Analytics); replace with the shadow-mode baseline.
MINUTES_SAVED_PER_ORDER=10

# --- Microsoft Graph attachment tools ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_SENDER_EMAILS=
ATTACHMENT_OUTPUT_DIR=attachments
