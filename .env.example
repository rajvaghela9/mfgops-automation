# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# --- Modes ---
# Where orders come from:
#   "mail" reads the newest "Infoblox Orders Backlog Report" Fusion mails to GRAPH_API_MAILBOX
#   "file" reads a saved backlog report .xls (BACKLOG_FILE_PATH below)
#   "mock" (default) has only the 5 dummy orders; "live" calls Fusion (not available yet).
FUSION_MODE=mock
# Used when FUSION_MODE=file: a saved "Infoblox Orders Backlog Report" .xls from Fusion.
BACKLOG_FILE_PATH=
# In mail and file mode, also show the 5 dummy orders ("dummy_..."), listed last.
INCLUDE_DEMO_ORDERS=true
# "mock" writes emails to OUTBOX_DIR as .html files; "live" sends them through MS Graph.
EMAIL_MODE=mock

# --- MS Graph (Outlook mail): app registration with Mail.Read + Mail.Send on the mailbox ---
GRAPH_API_TENANT_ID=
GRAPH_API_CLIENT_ID=
GRAPH_API_CLIENT_SECRET=
# Mailbox that receives the Fusion backlog report mails, e.g. mfgopstest@infoblox.com.
GRAPH_API_MAILBOX=
# Folder to read (well-known name or folder id).
GRAPH_API_FOLDER=inbox
# Mailbox emails are sent from (blank = GRAPH_API_MAILBOX).
GRAPH_API_SENDER_MAILBOX=
# How the backlog report mails are recognized.
BACKLOG_SENDER=efpv.bi.sender@workflow.mail.us6.oraclecloud.com
BACKLOG_SUBJECT=Infoblox Orders Backlog Report
BACKLOG_ATTACHMENT_NAME=Infoblox Orders Backlog Report.xls
# How many downloaded reports to keep under ATTACHMENTS_DIR/backlog.
BACKLOG_ATTACHMENT_KEEP=20

# --- Fusion Dev1 (only needed when FUSION_MODE=live) ---
FUSION_BASE_URL=https://efpv-dev1.fa.us6.oraclecloud.com
# Either Basic Auth for the integration user...
FUSION_USERNAME=
FUSION_PASSWORD=
# ...or OAuth 2.0 client credentials (used when all three are set).
FUSION_CLIENT_ID=
FUSION_CLIENT_SECRET=
FUSION_TOKEN_URL=

# --- AI via Infoblox LiteLLM proxy. Blank = AI off: only the fixed (hard) rules run ---
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Tested: gpt-5.4-mini (fast, cheap, good). Run `/v1/models` on your proxy for others.
LITELLM_MODEL=gpt-5.4-mini

# --- Email recipients ---
OM_TEAM_EMAIL=
# Gets the special-instructions mail once a Special Instructions order is released.
ARROW_RECIPIENT_EMAIL=
# Testing: when set, EVERY email goes to this address instead (the intended recipient is
# shown at the top of the mail). Leave blank only when real OM / Arrow mail is approved.
EMAIL_REDIRECT_TO=

# --- Storage (all under data/, which is gitignored) ---
DB_PATH=data/mfgops.db
# Where paused order reviews and rule chats are saved (LangGraph checkpoints).
WORKFLOW_DB_PATH=data/workflow_checkpoints.db
ATTACHMENTS_DIR=data/attachments
OUTBOX_DIR=data/outbox

# --- Service ---
POLL_INTERVAL_SECONDS=300
HEALTHZ_PORT=8080
# Warn when an approved order has no USPO from Fusion after this many minutes.
USPO_WAIT_WARNING_MINUTES=60
# Assumed manual minutes saved per order (Analytics); replace with the shadow-mode baseline.
MINUTES_SAVED_PER_ORDER=10
